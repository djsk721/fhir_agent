# Source profile / PostgreSQL
SOURCE_PROFILE_PATH=./profiles/fhir_ndjson_cohort/profile.json
SOURCE_DB_URL=postgresql+psycopg2://user:password@db-host:5432/clinical
SOURCE_DATA_PATH=./data/fhir-cohort

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_CONTEXT_SIZE=8192
OLLAMA_MAX_OUTPUT_TOKENS=4096
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_DELAY_SECONDS=2
LLM_SQL_MAX_ATTEMPTS=5
EMBEDDING_DIMENSION=768

# FHIR
FHIR_SCHEMA_PATH=./db/fhir.schema.json
FHIR_DEFAULT_TIMEZONE=Z

# SQL policy: public과 시스템 스키마를 제외한 모든 사용자 테이블을 자동 탐색합니다.
SQL_MAX_ROWS=10000
SQL_STATEMENT_TIMEOUT_MS=15000
DB_CONNECT_TIMEOUT_SECONDS=5
SOURCE_PATIENT_ID=
SOURCE_MAX_ENCOUNTERS=100
SOURCE_MAX_OBSERVATIONS_PER_ENCOUNTER=2000
SOURCE_MAX_CONDITIONS_PER_ENCOUNTER=1000
SOURCE_MAX_PROCEDURES_PER_ENCOUNTER=1000

# VectorDB
VECTOR_SCHEMA=public
FHIR_VECTOR_TABLE=fhir_schema_vectors
SQL_VECTOR_TABLE=source_sql_schema_vectors
VECTOR_SEARCH_K=30
VECTORS_ENABLED=true
VECTOR_BATCH_SIZE=64

# Output / validation
FHIR_OUTPUT_RESOURCES=Patient,Encounter,Condition,Procedure,Observation
FHIR_OUTPUT_PATH=./fhir_output/bundle.json
FHIR_EXPORT_DIR=./fhir_export
FHIR_VALIDATOR_JAR=
FHIR_VERSION=4.0.1
FHIR_VALIDATOR_TIMEOUT_SECONDS=120
FHIR_VALIDATOR_MAX_OUTPUT_CHARS=10000
# 원격 terminology 서비스가 불안정한 환경에서는 n/a로 설정합니다.
FHIR_VALIDATOR_TERMINOLOGY_SERVER=
