{
  "source_columns": {
    "patient": {
      "subject_id": "subject_id",
      "gender": "gender",
      "death_date": "dod"
    },
    "admission": {
      "subject_id": "subject_id",
      "admission_id": "hadm_id",
      "admission_type": "admission_type",
      "start_time": "admittime",
      "end_time": "dischtime"
    },
    "lab_event": {
      "subject_id": "subject_id",
      "admission_id": "hadm_id",
      "event_id": "labevent_id",
      "row_id": "row_id",
      "item_id": "itemid",
      "event_time": "charttime",
      "numeric_value": "valuenum",
      "text_value": "value",
      "unit": "valueuom",
      "reference_low": "ref_range_lower",
      "reference_high": "ref_range_upper",
      "interpretation": "flag"
    },
    "diagnosis": {
      "subject_id": "subject_id",
      "admission_id": "hadm_id",
      "sequence": "seq_num",
      "code": "icd_code",
      "version": "icd_version",
      "display": "long_title"
    },
    "procedure": {
      "subject_id": "subject_id",
      "admission_id": "hadm_id",
      "sequence": "seq_num",
      "date": "chartdate",
      "code": "icd_code",
      "version": "icd_version",
      "display": "long_title"
    }
  },
  "patient": {
    "gender_map": {
      "M": "male",
      "F": "female"
    }
  },
  "encounter": {
    "default_class": "IMP",
    "class_system": "http://terminology.hl7.org/CodeSystem/v3-ActCode",
    "class_by_admission_type": {
      "AMBULATORY OBSERVATION": "AMB",
      "DIRECT EMER.": "EMER",
      "DIRECT OBSERVATION": "OBSENC",
      "ELECTIVE": "IMP",
      "EU OBSERVATION": "OBSENC",
      "EW EMER.": "EMER",
      "OBSERVATION ADMIT": "OBSENC",
      "SURGICAL SAME DAY ADMISSION": "SS",
      "URGENT": "IMP"
    },
    "status_when_ended": "finished",
    "status_when_open": "in-progress"
  },
  "identifiers": {
    "patient_system": "urn:mimic:subject-id",
    "encounter_system": "urn:mimic:hadm-id",
    "lab_item_system": "urn:mimic:itemid",
    "lab_event_system": "urn:mimic:labevent-id",
    "condition_system": "urn:mimic:diagnosis-icd",
    "procedure_system": "urn:mimic:procedure-icd"
  },
  "resource_ids": {
    "patient": {"template": "{subject_id}"},
    "encounter": {"template": "{admission_id}"},
    "condition": {"template": "{admission_id}-{sequence}"},
    "procedure": {"template": "{admission_id}-{sequence}"},
    "observation": {"candidates": ["event_id", "row_id", "item_id"]}
  },
  "terminology": {
    "diagnosis_icd9_system": "http://hl7.org/fhir/sid/icd-9-cm",
    "diagnosis_icd10_system": "http://hl7.org/fhir/sid/icd-10-cm",
    "procedure_icd9_system": "http://hl7.org/fhir/sid/icd-9-cm",
    "procedure_icd10_system": "http://www.cms.gov/Medicare/Coding/ICD10",
    "diagnosis_decimal_positions": {"9": 3, "10": 3},
    "procedure_decimal_positions": {"9": 2, "10": null},
    "diagnosis_prefix_decimal_positions": {"9": {"E": 4}},
    "procedure_prefix_decimal_positions": {}
  },
  "fhir_defaults": {
    "observation_status": "final",
    "observation_category_system": "http://terminology.hl7.org/CodeSystem/observation-category",
    "observation_category_code": "laboratory",
    "condition_category_system": "http://terminology.hl7.org/CodeSystem/condition-category",
    "condition_category_code": "encounter-diagnosis",
    "procedure_status": "completed",
    "ucum_system": "http://unitsofmeasure.org",
    "ucum_code_map": {
      "IU/L": "[IU]/L",
      "mEq/L": "meq/L"
    },
    "observation_interpretation_system": "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation",
    "observation_interpretation": {
      "ABNORMAL": {"code": "A", "display": "Abnormal"}
    }
  },
  "evaluation": {
    "allowed_top_level_fields": {
      "Patient": [
        "resourceType", "id", "identifier", "gender", "deceasedDateTime"
      ],
      "Encounter": [
        "resourceType", "id", "identifier", "status", "class", "subject",
        "period"
      ],
      "Condition": [
        "resourceType", "id", "identifier", "category", "code", "subject",
        "encounter"
      ],
      "Procedure": [
        "resourceType", "id", "identifier", "status", "code", "subject",
        "encounter", "performedDateTime"
      ],
      "Observation": [
        "resourceType", "id", "identifier", "status", "category", "code",
        "subject", "encounter", "effectiveDateTime", "valueQuantity",
        "valueString", "referenceRange", "interpretation"
      ]
    }
  }
}
